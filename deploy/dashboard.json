  "title": "Sentinel \u2014 Runaway Agent Detection + AgentLineage",
  "variables": {},
  "version": "v5",
  "widgets": [
    {
      "contextLinks": {
        "linksData": []
      },
      "description": "Count of sentinel.alert.received spans",
      "id": "score-alerts",
      "nullZeroValues": "zero",
      "opacity": "1",
      "panelTypes": "value",
      "query": {
        "chQuery": "SELECT count() FROM signoz_spans WHERE name = 'sentinel.alert.received' AND timestamp >= now() - INTERVAL 1 HOUR",
        "queryType": "clickhouse_sql"
      },
      "selectedLogFields": [],
      "selectedTracesFields": [],
      "timePreferance": "GLOBAL_TIME",
      "title": "Total Alerts Received"
    },
    {
      "contextLinks": {
        "linksData": []
      },
      "description": "Count of sentinel.agent.quarantined spans",
      "id": "score-quar",
      "nullZeroValues": "zero",
      "opacity": "1",
      "panelTypes": "value",
      "query": {
        "chQuery": "SELECT count() FROM signoz_spans WHERE name = 'sentinel.agent.quarantined' AND timestamp >= now() - INTERVAL 1 HOUR",
        "queryType": "clickhouse_sql"
      },
      "selectedLogFields": [],
      "selectedTracesFields": [],
      "timePreferance": "GLOBAL_TIME",
      "title": "Quarantines"
    },
    {
      "contextLinks": {
        "linksData": []
      },
      "description": "Count of sentinel.agent.released spans",
      "id": "score-rel",
      "nullZeroValues": "zero",
      "opacity": "1",
      "panelTypes": "value",
      "query": {
        "chQuery": "SELECT count() FROM signoz_spans WHERE name = 'sentinel.agent.released' AND timestamp >= now() - INTERVAL 1 HOUR",
        "queryType": "clickhouse_sql"
      },
      "selectedLogFields": [],
      "selectedTracesFields": [],
      "timePreferance": "GLOBAL_TIME",
      "title": "Releases"
    },
    {
      "contextLinks": {
        "linksData": []
      },
      "description": "sentinel.agent.quarantined spans per minute",
      "id": "graph-quar",
      "nullZeroValues": "zero",
      "opacity": "1",
      "panelTypes": "graph",
      "query": {
        "chQuery": "SELECT toStartOfMinute(timestamp) as t, count() as q FROM signoz_spans WHERE name = 'sentinel.agent.quarantined' AND timestamp >= now() - INTERVAL 6 HOUR GROUP BY t ORDER BY t",
        "queryType": "clickhouse_sql"
      },
      "selectedLogFields": [],
      "selectedTracesFields": [],
      "timePreferance": "GLOBAL_TIME",
      "title": "Quarantine Events Over Time"
    },
    {
      "contextLinks": {
        "linksData": []
      },
      "description": "Agent\u2192artifact touch events from AgentLineage",
      "id": "score-lineage",
      "nullZeroValues": "zero",
      "opacity": "1",
      "panelTypes": "value",
      "query": {
        "chQuery": "SELECT count() FROM signoz_spans WHERE name = 'artifact.touched' AND timestamp >= now() - INTERVAL 1 HOUR",
        "queryType": "clickhouse_sql"
      },
      "selectedLogFields": [],
      "selectedTracesFields": [],
      "timePreferance": "GLOBAL_TIME",
      "title": "Lineage Events (artifact.touched)"
    },
    {
      "contextLinks": {
        "linksData": []
      },
      "description": "artifact.touched spans per agent per minute",
      "id": "graph-lineage",
      "nullZeroValues": "zero",
      "opacity": "1",
      "panelTypes": "graph",
      "query": {
        "chQuery": "SELECT toStartOfMinute(timestamp) as t, attributes_string['agent.id'] as agent, count() as touches FROM signoz_spans WHERE name = 'artifact.touched' AND timestamp >= now() - INTERVAL 6 HOUR GROUP BY t, agent ORDER BY t",
        "queryType": "clickhouse_sql"
      },
      "selectedLogFields": [],
      "selectedTracesFields": [],
      "timePreferance": "GLOBAL_TIME",
      "title": "Agent\u2192Artifact Lineage"
    }
  ]
}