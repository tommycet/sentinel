{
  "title": "Sentinel — Runaway Agent Detection",
  "description": "Closed-loop agent runaway detection: quarantine events, release events, and credential-hash flow from the Sentinel service exported via OTLP.",
  "tags": ["sentinel", "agent", "security", "traces"],
  "variables": {},
  "version": "v5",
  "layout": [
    {"h": 4, "i": "score-alerts", "moved": false, "static": false, "w": 4, "x": 0, "y": 0},
    {"h": 4, "i": "score-quar", "moved": false, "static": false, "w": 4, "x": 4, "y": 0},
    {"h": 4, "i": "score-rel", "moved": false, "static": false, "w": 4, "x": 8, "y": 0},
    {"h": 6, "i": "graph-quar", "moved": false, "static": false, "w": 12, "x": 0, "y": 4}
  ],
  "panelMap": {},
  "widgets": [
    {
      "id": "score-alerts",
      "title": "Total Alerts Received",
      "panelTypes": "value",
      "description": "Count of sentinel.alert.received spans",
      "query": {
        "queryType": "clickhouse_sql",
        "chQuery": "SELECT count() FROM signoz_spans WHERE name = 'sentinel.alert.received' AND timestamp >= now() - INTERVAL 1 HOUR"
      },
      "selectedTracesFields": [],
      "selectedLogFields": [],
      "timePreferance": "GLOBAL_TIME",
      "opacity": "1",
      "nullZeroValues": "zero",
      "contextLinks": {"linksData": []}
    },
    {
      "id": "score-quar",
      "title": "Quarantines",
      "panelTypes": "value",
      "description": "Count of sentinel.agent.quarantined spans",
      "query": {
        "queryType": "clickhouse_sql",
        "chQuery": "SELECT count() FROM signoz_spans WHERE name = 'sentinel.agent.quarantined' AND timestamp >= now() - INTERVAL 1 HOUR"
      },
      "selectedTracesFields": [],
      "selectedLogFields": [],
      "timePreferance": "GLOBAL_TIME",
      "opacity": "1",
      "nullZeroValues": "zero",
      "contextLinks": {"linksData": []}
    },
    {
      "id": "score-rel",
      "title": "Releases",
      "panelTypes": "value",
      "description": "Count of sentinel.agent.released spans",
      "query": {
        "queryType": "clickhouse_sql",
        "chQuery": "SELECT count() FROM signoz_spans WHERE name = 'sentinel.agent.released' AND timestamp >= now() - INTERVAL 1 HOUR"
      },
      "selectedTracesFields": [],
      "selectedLogFields": [],
      "timePreferance": "GLOBAL_TIME",
      "opacity": "1",
      "nullZeroValues": "zero",
      "contextLinks": {"linksData": []}
    },
    {
      "id": "graph-quar",
      "title": "Quarantine Events Over Time",
      "panelTypes": "graph",
      "description": "sentinel.agent.quarantined spans per minute",
      "query": {
        "queryType": "clickhouse_sql",
        "chQuery": "SELECT toStartOfMinute(timestamp) as t, count() as q FROM signoz_spans WHERE name = 'sentinel.agent.quarantined' AND timestamp >= now() - INTERVAL 6 HOUR GROUP BY t ORDER BY t"
      },
      "selectedTracesFields": [],
      "selectedLogFields": [],
      "timePreferance": "GLOBAL_TIME",
      "opacity": "1",
      "nullZeroValues": "zero",
      "contextLinks": {"linksData": []}
    }
  ]
}
